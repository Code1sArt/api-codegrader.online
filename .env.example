NODE_ENV=development
PORT=3100
DATABASE_URL="mysql://root:your_url_encoded_password@127.0.0.1:3306/labedu_grader"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_SECONDS=86400
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# OAuth 2.0 Web Client ID. The frontend sends the Google ID token to /api/auth/google.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Comma-separated emails promoted to ADMIN on sign-in. Existing roles are not downgraded.
ADMIN_EMAILS="admin@example.com"

# Same self-hosted Piston protocol used by api-SC-Exam.
PISTON_BASE_URL="http://127.0.0.1:2000/api/v2"
PISTON_CPP_VERSION="10.2.0"
PISTON_PYTHON_VERSION="3.12.0"
RUNNER_MAX_CONCURRENCY=2
RUNNER_REQUEST_TIMEOUT_MS=30000
